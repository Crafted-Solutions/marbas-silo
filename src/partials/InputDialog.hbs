{{#> partials/_DialogModal dlgScope='input-dlg' dlgClasses='modal-over fade'}}
{{> partials/_DialogModalHeader dlgScope=dlgScope dlgTitle=(_ 'Input Request')}}
<form class="modal-body needs-validation" action="#" onsubmit="return false;" novalidate>
	<div class="mb-3">
		<label for="{{dlgScope}}-txt" class="form-label">{{_ 'Input'}}</label>
		<input type="text" class="form-control" id="{{dlgScope}}-txt" placeholder="" value="" aria-describedby="{{dlgScope}}-txt-fb" required>
		<div id="{{dlgScope}}-txt-fb" class="invalid-feedback">
			{{_ 'Value is required'}}
		</div>
	</div>
</form>
{{> partials/_DialogFooter dlgScope=dlgScope}}
{{/partials/_DialogModal}}