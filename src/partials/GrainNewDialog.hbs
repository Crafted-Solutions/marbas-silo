{{#> partials/_DialogModal dlgScope='grain-new' dlgClasses='modal-over fade'}}
{{> partials/_DialogModalHeader dlgScope=dlgScope dlgTitle=(_ 'New Grain')}}
<form class="modal-body needs-validation" action="#" onsubmit="return false;" novalidate>
	<div class="mb-3">
		<label for="{{dlgScope}}-txt-name" class="form-label">{{_ 'Name'}}</label>
		<input type="text" class="form-control" id="{{dlgScope}}-txt-name" placeholder="{{_ 'Name for the new element'}}" value="" aria-describedby="{{dlgScope}}-txt-name-fb" required>
		<div id="{{dlgScope}}-txt-name-fb" class="invalid-feedback">
			{{_ 'Please provide a name for the element'}}
		</div>
	</div>
	<div class="mb-3" id="{{dlgScope}}-type-fields">
		<span class="btn-group ms-1 mb-1 float-end">{{> partials/_ButtonReload dlgScope=dlgScope}}</span>
		<label for="{{dlgScope}}-sel-type" class="col-form-label">{{_ 'Type'}}</label>
		<nav id="{{dlgScope}}-sel-type"></nav>
	</div>
</form>
{{> partials/_DialogFooter dlgScope=dlgScope}}
{{/partials/_DialogModal}}